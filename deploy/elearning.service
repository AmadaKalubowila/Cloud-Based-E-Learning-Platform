[Unit]
Description=Cloud-Based E-Learning Platform (Spring Boot)
After=network.target

[Service]
Type=simple
User=elearning
WorkingDirectory=/opt/elearning
ExecStart=/usr/bin/java -jar /opt/elearning/elearning.jar
EnvironmentFile=/opt/elearning/elearning.env
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
